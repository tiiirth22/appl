# ApplianceIQ Backend Configuration Template

# Authentication
JWT_SECRET_KEY=generate-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200  # 30 days

# QR Code Security
QR_SECRET_KEY=another-random-string

# Database
# Production: mongodb+srv://<user>:<password>@cluster.mongodb.net/applianceiq_db
MONGO_URL=mongodb://localhost:27017
DB_NAME=applianceiq_db

# External Services (RAG)
# Get your key at console.groq.com
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama3-70b-8192

# Get your key at pinecone.io
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX_NAME=appliance-manuals
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Get your URL at cloudinary.com (Settings -> API Keys)
# Looks like: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=your_cloudinary_url

# Application URLs
# This is used for generating QR code links
APP_BASE_URL=https://your-frontend.vercel.app

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app
