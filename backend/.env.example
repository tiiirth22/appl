# Backend Service Configuration (.env.example)
# Copy this file to .env and fill in your values

# ===== Database Configuration =====
MONGO_URL=mongodb://localhost:27017
DB_NAME=applianceiq_db

# ===== ML Service Configuration =====
# URL of the ML Service instance
ML_SERVICE_URL=http://localhost:8001
ML_SERVICE_TIMEOUT=120
ML_SERVICE_MAX_RETRIES=3

# ===== Authentication =====
JWT_SECRET_KEY=your_secret_key_here_change_in_production
JWT_ALGORITHM=HS256
SESSION_TIMEOUT_HOURS=24

# ===== File Upload Configuration =====
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
MAX_UPLOAD_SIZE_MB=100

# ===== CORS Configuration =====
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ===== QR Code Configuration =====
QR_SECRET_KEY=your_qr_secret_key_here
QR_BASE_URL=https://yourapp.com

# ===== Logging =====
LOG_LEVEL=INFO
DEBUG=false

# ===== Service Configuration =====
SERVICE_PORT=8000
SERVICE_HOST=0.0.0.0
